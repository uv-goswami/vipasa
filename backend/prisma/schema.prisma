generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  phone        String         @unique
  passwordHash String         @map("password_hash")
  role         Role
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  firstName    String         @map("first_name")
  lastName     String?        @map("last_name")
  admin        Admin?
  client       ClientProfile?
  staff        StaffProfile?

  @@map("user")
}

model Admin {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  @@map("admin")
}

model ClientProfile {
  userId     String    @id @map("user_id")
  gender     Gender?
  fatherName String?   @map("father_name")
  dob        DateTime?

  addressLine String? @map("address_line")
  city        String?
  state       String?
  pincode     String?

  aadharDocUrl    String?     @map("aadhar_doc_url")
  panDocUrl       String?     @map("pan_doc_url")
  taxId           String?     @map("tax_ID")
  clientType      ClientType? @map("client_type")
  industry        String?
  riskScore       Int?        @map("risk_score")
  assignedStaffId String?     @map("assigned_staff_id")

  applications Application[]
  staff        StaffProfile? @relation(fields: [assignedStaffId], references: [userId])
  user         User          @relation(fields: [userId], references: [id])
  documents    Document[]

  @@map("client_profile")
}

model StaffProfile {
  userId              String          @id @map("user_id")
  gender              Gender?
  joiningDate         DateTime        @default(now()) @map("joining_date")
  exitDate            DateTime?       @map("exit_date")
  salary              Decimal         @db.Decimal(12, 2)
  skills              String[]
  resume              String?
  qualifications      String?
  managedApplications Application[]
  assignedClients     ClientProfile[]
  user                User            @relation(fields: [userId], references: [id])

  @@map("staff_profile")
}

model Application {
  id String @id @default(uuid())

  name          String
  applicationNo String @unique @map("application_no")

  clientId  String  @map("client_id")
  serviceId String
  staffId   String? @map("staff_id")

  status   Status   @default(Draft)
  priority Priority @default(Normal)

  createdAt   DateTime  @default(now()) @map("created_at")
  submittedAt DateTime? @map("submitted_at")
  completedAt DateTime? @map("completed_at")
  dueDate     DateTime? @map("due_date")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  decision       ApplicationDecision?
  decisionReason String?              @map("decision_reason")

  description  String?
  internalNote String? @map("internal_note")
  clientNote   String? @map("client_note")

  metadata Json?

  //Relationship
  client    ClientProfile @relation(fields: [clientId], references: [userId])
  service   Service       @relation(fields: [serviceId], references: [id])
  staff     StaffProfile? @relation(fields: [staffId], references: [userId])
  documents Document[]

  @@map("application")
}

model Document {
  id            String         @id @default(uuid()) @map("doc_id")
  clientId      String?        @map("client_id")
  applicationId String?        @map("application_id")
  name          String
  docUrl        String         @map("doc_url")
  docType       String         @map("doc_type")
  uploadedAt    DateTime       @default(now()) @map("uploaded_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  application   Application?   @relation(fields: [applicationId], references: [id])
  client        ClientProfile? @relation(fields: [clientId], references: [userId])

  @@map("document")
}

model Service {
  id            String        @id @default(uuid())
  name          String        @unique
  description   String?
  basePrice     Decimal       @db.Decimal(12, 2)
  requiredDocs  String[]      @map("required_docs")
  estimatedDays Int           @map("estimated_days")
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  applications  Application[]

  @@map("service")
}

enum Role {
  Admin
  Staff
  Client
}

enum Gender {
  Male
  Female
}

enum ClientType {
  Individual
  Corporate
  Government
}

enum Status {
  Draft
  PendingDocuments
  UnderReview
  Approved
  Rejected
  Completed
}

enum Priority {
  Low
  Normal
  High
  Urgent
}

enum ApplicationDecision {
  Draft
  Approved
  Rejected
  PendingDocuments
  UnderReview
  Completed
}
