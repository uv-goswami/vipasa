// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}


enum Role{
  ADMIN
  STAFF
  CLIENT
}

enum Gender{
  Male
  Female
}

model User{
  id String @id @default(uuid())
  email String @unique
  phone String @unique
  passwordHash String @map("password_hash")
  role Role
  isActive Boolean @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  admin Admin?
  client ClientProfile?
  staff StaffProfile?

  @@map("user")
}

model Admin{
  firstName String @map("first_name")
  lastName String? @map("last_name")

  userId String @id @map("user_Id")
  user User @relation(fields:[userId], references:[id])

  @@map("admin")
}

enum ClientType{
  Individual
  Corporate
  Government
}

model ClientProfile{
  userId String @id @map("user_id")
  user User @relation(fields:[userId], references: [id])

  firstName String @map("first_name")
  lastName String? @map("last_name")
  gender Gender? @default(Male)
  fatherName String? @map("father_name")
  dob DateTime? 



  aadharDocUrl String? @map("aadhar_doc_url")
  panDocUrl String? @map("pan_doc_url")
  taxId String? @map("tax_ID") 

  clientType ClientType @default(Individual) @map("client_type")

  industry String?
  riskScore Int? @map("risk_score") 
  assignedStaffId String?  @map("assigned_staff_id")
  staff StaffProfile? @relation(fields:[assignedStaffId], references: [userId])

  applications Application[]
  documents Document[]
  @@map("client_profile")
}

model StaffProfile{
  userId String @id @map("user_id")
  user User @relation(fields:[userId], references: [id])

  firstName String @map("first_name")
  lastName String? @map("last_name")
  gender Gender? @default(Female)


  joiningDate DateTime @default(now()) @map("joining_date")
  exitDate DateTime? @map("exit_date")

  salary Decimal @db.Decimal(12,2)

  skills String[]
  resume String?
  qualifications String?

  assignedClients ClientProfile[]
  managedApplications Application[]

  @@map("staff_profile")
}

//Application-----------------------------

enum Status{
  Draft
  PendingDocuments
  UnderReview
  Approved
  Rejected
  Completed
}

enum Priority{
  Low
  Medium
  High
}

model Application{
  id String @id @default(uuid())
  status Status? 
  priority Priority?

  clientId String @map("client_id")
  client ClientProfile @relation(fields:[clientId], references:[userId])

  staffId String? @map("staff_id")
  staff StaffProfile? @relation(fields:[staffId], references:[userId])

  lastDate DateTime? @map("last_date")
  lastUpdatedAt DateTime? @updatedAt @map("last_updated_at")
  submittedAt DateTime? @map("submitted_at")
  completedAt DateTime? @map("completed_at")

  description String? @db.Text
  internalNote String? @db.Text @map("internal_note")

  serviceId String
  service Service @relation(fields:[serviceId], references:[id])

  metadata Json?

  documents Document[]

  @@map("application")
}

model Document{
  id String @id @default(uuid()) @map("doc_id")

  clientId String? @map("client_Id")
  client ClientProfile? @relation(fields:[clientId], references:[userId])

  applicationId String? @map("application_Id")
  application Application? @relation(fields:[applicationId], references:[id])

  name String
  docUrl String @map("doc_url")
  docType String @map("doc_type")

  uploadedAt DateTime @default(now()) @map("uploaded_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("documents")
}


model Service{
  id String @id @default(uuid())
  description String? @db.Text
  basePrice Decimal @db.Decimal(12,2)

  requiredDocs String[] @map("required_docs")
  estimatedDays Int @map("estimated_days")
  isActive Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at")
  updated_at DateTime @updatedAt @map("updated_at")

  applications Application[]

  @@map("services")
}
