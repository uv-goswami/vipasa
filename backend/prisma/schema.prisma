generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String         @id @default(uuid())
  email        String         @unique
  phone        String         @unique
  passwordHash String         @map("password_hash")
  role         Role
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  firstName    String         @map("first_name")
  lastName     String?        @map("last_name")
  Admin        Admin?
  Client       ClientProfile?
  Staff        StaffProfile?

  @@map("user")
}

model Admin {
  userId String @id @map("user_Id")
  user   User   @relation(fields: [userId], references: [id])

  @@map("Admin")
}

model ClientProfile {
  userId          String        @id @map("user_id")
  gender          Gender?       
  fatherName      String?       @map("father_name")
  dob             DateTime?

  addressLine     String?       @map("address_line")
  city            String?
  state           String?
  pincode         String?

  aadharDocUrl    String?       @map("aadhar_doc_url")
  panDocUrl       String?       @map("pan_doc_url")
  taxId           String?       @map("tax_ID")
  ClientType      ClientType?    @map("Client_type")
  industry        String?
  riskScore       Int?          @map("risk_score")
  assignedStaffId String?       @map("assigned_Staff_id")

  applications    Application[]
  Staff           StaffProfile? @relation(fields: [assignedStaffId], references: [userId])
  user            User          @relation(fields: [userId], references: [id])
  documents       Document[]

  @@map("Client_profile")
}

model StaffProfile {
  userId              String          @id @map("user_id")
  gender              Gender?
  joiningDate         DateTime        @default(now()) @map("joining_date")
  exitDate            DateTime?       @map("exit_date")
  salary              Decimal         @db.Decimal(12, 2)
  skills              String[]
  resume              String?
  qualifications      String?
  managedApplications Application[]
  assignedClients     ClientProfile[]
  user                User            @relation(fields: [userId], references: [id])

  @@map("Staff_profile")
}

model Application {
  id            String        @id @default(uuid())
  name          String
  status        Status?
  priority      Priority?
  ClientId      String        @map("Client_id")
  StaffId       String?       @map("Staff_id")
  lastDate      DateTime?     @map("last_date")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  submittedAt   DateTime?     @map("submitted_at")
  completedAt   DateTime?     @map("completed_at")
  description   String?
  internalNote  String?       @map("internal_note")
  serviceId     String
  metadata      Json?
  Client        ClientProfile @relation(fields: [ClientId], references: [userId])
  service       Service       @relation(fields: [serviceId], references: [id])
  Staff         StaffProfile? @relation(fields: [StaffId], references: [userId])
  documents     Document[]

  @@map("application")
}

model Document {
  id            String         @id @default(uuid()) @map("doc_id")
  ClientId      String?        @map("Client_Id")
  applicationId String?        @map("application_Id")
  name          String
  docUrl        String         @map("doc_url")
  docType       String         @map("doc_type")
  uploadedAt    DateTime       @default(now()) @map("uploaded_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  application   Application?   @relation(fields: [applicationId], references: [id])
  Client        ClientProfile? @relation(fields: [ClientId], references: [userId])

  @@map("documents")
}

model Service {
  id            String        @id @default(uuid())
  name          String        @unique
  description   String?
  basePrice     Decimal       @db.Decimal(12, 2)
  requiredDocs  String[]      @map("required_docs")
  estimatedDays Int           @map("estimated_days")
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  applications  Application[]

  @@map("services")
}

enum Role {
  Admin
  Staff
  Client
}

enum Gender {
  Male
  Female
}

enum ClientType {
  Individual
  Corporate
  Government
}

enum Status {
  Draft
  PendingDocuments
  UnderReview
  Approved
  Rejected
  Completed
}

enum Priority {
  Low
  Medium
  High
}
